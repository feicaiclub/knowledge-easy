{
  "version": "2.1.1",
  "renderer": "editorial.py",
  "styles": [
    "pack.css",
    "editorial.css",
    "type.css"
  ],
  "geography": "geography.py",
  "entry_point": "render(component, instance_id, duration_seconds, content_data, local_semantic_cues, locale)",
  "returns": [
    "html",
    "js",
    "reading_order",
    "component",
    "parent",
    "version",
    "layout",
    "design_reference",
    "implementation"
  ],
  "episode_may_change": [
    "content and source material",
    "visual premise and editorial structure",
    "palette and material language",
    "typography and layout through project-owned artwork/renderers",
    "subjects, poses and spatial composition",
    "camera, semantic events and pace",
    "voice/performance when requested",
    "music and sound design",
    "duration and scene ordering"
  ],
  "library_owns": [
    "versioned reusable drawing/layout techniques",
    "deterministic rendering contracts",
    "source and provenance tracking",
    "validation of declared bounds and timeline intervals"
  ],
  "rules": [
    "The project chooses its visual language and reference; bundled classic layouts are optional.",
    "Reusable techniques do not prescribe a story, cast, shot sequence or timeline.",
    "Drawing source, renderer extensions and reference files are tracked in the build/export signature.",
    "Cinematic component scenes use the shared native backdrop treatment; raw footage and authored paper remain explicit alternatives.",
    "A graphic may use footage, paper, solid/gradient surfaces or original artwork.",
    "Reading text, facts and relationships remain clear at delivery size.",
    "Technical success does not certify art direction, motion, whole-film pacing or sound.",
    "Existing project snapshots are upgraded intentionally."
  ],
  "public_variants": {
    "map-decision": {
      "parent": "map-route",
      "points": 2,
      "required": [
        "title",
        "view",
        "points",
        "stages"
      ],
      "directions": "all directions; proposed route uses a dashed path",
      "stages": "1 to 3"
    },
    "map-focus-chain": {
      "parent": "map-focus",
      "points": "2 to 4",
      "required": [
        "title",
        "view",
        "points",
        "stages"
      ]
    },
    "credential": {
      "parent": "evidence",
      "required": [
        "image",
        "person",
        "issuer",
        "role",
        "details"
      ]
    },
    "evidence-sheet": {
      "parent": "evidence",
      "required": [
        "image",
        "title"
      ],
      "optional": [
        "image_label",
        "kicker",
        "body",
        "closing"
      ]
    },
    "relation-bridge": {
      "parent": "relation",
      "nodes": 2,
      "required": [
        "nodes",
        "relation"
      ],
      "optional": [
        "title",
        "node sublabels"
      ]
    },
    "name-roster": {
      "parent": "relation",
      "items": "1 to 3",
      "layouts": [
        "portrait",
        "closing"
      ]
    },
    "quote-reveal": {
      "parent": "evidence",
      "required": [
        "lead",
        "emphasis"
      ]
    },
    "milestone-pair": {
      "parent": "timeline",
      "items": 2,
      "required": [
        "date",
        "context",
        "statement"
      ]
    },
    "foundation": {
      "parent": "relation",
      "nodes": "2 to 4",
      "node_shape": "city",
      "required": [
        "title",
        "note",
        "items",
        "conclusion"
      ]
    },
    "feedback-loop": {
      "parent": "feedback",
      "nodes": 3,
      "required": [
        "title",
        "nodes[].image",
        "nodes[].label"
      ],
      "optional": [
        "conclusion"
      ],
      "geometry": "Three image nodes, reserved connector lanes, short single-line labels"
    },
    "evidence-collage": {
      "parent": "evidence",
      "items": 2,
      "required": [
        "title",
        "items[].image",
        "items[].label"
      ],
      "optional": [
        "items[].note",
        "relation"
      ],
      "geometry": "Two source artifacts with separate reading areas and a clear connecting lane"
    },
    "context-reveal": {
      "parent": "context",
      "required": [
        "image",
        "detail",
        "context"
      ],
      "optional": [
        "focus",
        "detail_scale",
        "reveal_duration"
      ],
      "geometry": "One media placement widens inside a fixed clipping window"
    },
    "lit-title": {
      "parent": "hero",
      "required": [
        "image",
        "left",
        "right"
      ],
      "optional": [
        "caption"
      ]
    },
    "medallion-labels": {
      "parent": "relation",
      "required": [
        "image",
        "labels"
      ],
      "optional": [
        "title",
        "caption"
      ]
    },
    "editorial-portrait": {
      "parent": "hero",
      "required": [
        "image",
        "title"
      ],
      "optional": [
        "caption",
        "accent"
      ]
    }
  },
  "languages": [
    "zh-CN"
  ],
  "base_designs": {
    "hero": {
      "required_text_slots": [
        "left",
        "right",
        "question"
      ],
      "foreground_media_slots": [
        "portrait-film"
