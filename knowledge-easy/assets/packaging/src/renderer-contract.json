        "t",
        "a-label",
        "b-label",
        "c-label",
        "n1",
        "n2"
      ],
      "foreground_media_slots": [
        "a-film",
        "b-film",
        "c-film"
      ],
      "examples": "base-examples.json"
    },
    "feedback": {
      "required_text_slots": [
        "t",
        "p0-label",
        "p1-label",
        "p2-label",
        "note"
      ],
      "foreground_media_slots": [
        "p0-film",
        "p1-film",
        "p2-film"
      ],
      "examples": "base-examples.json"
    },
    "quantity": {
      "required_text_slots": [
        "title",
        "total-label",
        "part-label",
        "note"
      ],
      "foreground_media_slots": [],
      "examples": "base-examples.json"
    },
    "timeline": {
      "required_text_slots": [
        "t"
      ],
      "foreground_media_slots": [
        "time-film0",
        "time-film1",
        "time-film2"
      ],
      "examples": "base-examples.json"
    },
    "map-focus": {
      "required_text_slots": [
        "t",
        "note"
      ],
      "foreground_media_slots": [],
      "examples": "base-examples.json"
    },
    "map-route": {
      "required_text_slots": [
        "t",
        "note"
      ],
      "foreground_media_slots": [],
      "examples": "base-examples.json"
    },
    "map-period": {
      "required_text_slots": [
        "t",
        "note"
      ],
      "foreground_media_slots": [],
      "examples": "base-examples.json"
    },
    "context": {
      "required_text_slots": [
        "a",
        "b"
      ],
      "foreground_media_slots": [
        "detail"
      ],
      "examples": "base-examples.json"
    }
  },
  "composition": {
    "scene_field": "components",
    "instance_fields": [
      "id",
      "component",
      "data",
      "cues",
      "start",
      "duration",
      "frame",
      "design_reference"
    ],
    "frame": "[x,y,width,height], uniform aspect-preserving fit on a 1920x1080 canvas",
    "defaults": "scene duration and full frame",
    "extension_signature": "render(kit, prefix, duration, data, cues, locale)",
    "design_reference": "classic/art ID or {src, reason, name?} project image"
  },
  "artwork": {
    "component": "artwork",
    "engines": [
      "etch",
      "print",
      "wash"
    ],
    "source": "project-owned JavaScript drawing body",
    "inputs": [
      "t",
      "ctx",
      "art",
      "data",
      "data.beats"
    ],
    "reference": "bundled art reference or project src/reason object",
    "example_source_is_not_a_template": true
  },
  "background": {
    "implementation": "backdrop.py",
    "treatments": [
      "cinematic",
      "raw"
    ],
    "grading": "native data-color-grading",
    "preview_and_build": "same render_background function"
  }
}
