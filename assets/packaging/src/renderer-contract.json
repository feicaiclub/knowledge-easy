{
  "version": "1.4.0",
  "renderer": "editorial.py",
  "styles": [
    "pack.css",
    "editorial.css"
  ],
  "geography": "geography.py",
  "entry_point": "render(component, instance_id, duration_seconds, content_data, local_semantic_cues, locale)",
  "returns": [
    "html",
    "js",
    "reading_order",
    "component",
    "parent",
    "version",
    "layout",
    "design_reference",
    "implementation"
  ],
  "episode_may_change": [
    "copy",
    "media and focal point",
    "facts and coordinates",
    "semantic cue times",
    "duration",
    "named layout variants",
    "component placement frames and local intervals",
    "explicit project extensions reviewed against handbook designs"
  ],
  "library_owns": [
    "typographic hierarchy",
    "palette",
    "card geometry",
    "alignment",
    "margins",
    "connector geometry",
    "motion dependencies",
    "map-note collision avoidance"
  ],
  "rules": [
    "Episodes call the renderer rather than copying or replacing component CSS.",
    "The handbook and films must use the same renderer version and source hashes.",
    "Release snapshots are explicit and immutable after delivery; upgrades are intentional.",
    "A new generic variant is documented with another subject and actually rendered before release.",
    "Every generated instance records parent family, version, data, cues and reading order.",
    "Explanatory cards and diagrams use visibly moving, softly blurred video backgrounds; intentional full-frame exceptions record a reason.",
    "Validate image and label obstacles, connector clearance, alignment, and caption-safe bounds during motion as well as at rest.",
    "All twelve base designs use the production render entry; catalogs call it too.",
    "Content substitution and component composition preserve the design baseline; helper calls and family labels alone are not visual reuse.",
    "Project extensions declare a source file and handbook reference; actual rendered markup drives review prompts.",
    "Technical rendering leaves design review pending. Export-bound comparison evidence and recorded visual judgments are checked by accept-visuals."
  ],
  "public_variants": {
    "map-decision": {
      "parent": "map-route",
      "points": 2,
      "required": [
        "title",
        "view",
        "points",
        "stages"
      ],
      "directions": "all directions; proposed route uses a dashed path",
      "stages": "1 to 3"
    },
    "map-focus-chain": {
      "parent": "map-focus",
      "points": "2 to 4",
      "required": [
        "title",
        "view",
        "points",
        "stages"
      ]
    },
    "credential": {
      "parent": "evidence",
      "required": [
        "image",
        "person",
        "issuer",
        "role",
        "details"
      ]
    },
    "evidence-sheet": {
      "parent": "evidence",
      "required": [
        "image",
        "title"
      ],
      "optional": [
        "image_label",
        "kicker",
        "body",
        "closing"
      ]
    },
    "relation-bridge": {
      "parent": "relation",
      "nodes": 2,
      "required": [
        "nodes",
        "relation"
      ],
      "optional": [
        "title",
        "node sublabels"
      ]
    },
    "name-roster": {
      "parent": "relation",
      "items": "1 to 3",
      "layouts": [
        "portrait",
        "closing"
      ]
    },
    "quote-reveal": {
      "parent": "evidence",
      "required": [
        "lead",
        "emphasis"
      ]
    },
    "milestone-pair": {
      "parent": "timeline",
      "items": 2,
      "required": [
        "date",
        "context",
        "statement"
      ]
    },
    "foundation": {
      "parent": "relation",
      "nodes": "2 to 4",
      "node_shape": "city",
      "required": [
        "title",
        "note",
        "items",
        "conclusion"
      ]
    },
    "feedback-loop": {
      "parent": "feedback",
      "nodes": 3,
      "required": [
        "title",
        "nodes[].image",
        "nodes[].label"
      ],
      "optional": [
        "conclusion"
      ],
      "geometry": "Three image nodes, reserved connector lanes, short single-line labels"
    },
    "evidence-collage": {
      "parent": "evidence",
      "items": 2,
      "required": [
        "title",
        "items[].image",
        "items[].label"
      ],
      "optional": [
        "items[].note",
        "relation"
      ],
      "geometry": "Two source artifacts with separate reading areas and a clear connecting lane"
    },
    "context-reveal": {
      "parent": "context",
      "required": [
        "image",
        "detail",
        "context"
      ],
      "optional": [
        "focus",
        "detail_scale",
        "reveal_duration"
      ],
      "geometry": "One media placement widens inside a fixed clipping window"
    }
  },
  "languages": [
    "en-US",
    "zh-CN"
  ],
  "base_designs": {
    "hero": {
      "required_text_slots": [
        "left",
        "right",
        "question"
      ],
      "foreground_media_slots": [
