      ],
      "foreground_media_slots": [
        "detail"
      ],
      "examples": "locales/<locale>/base-examples.json"
    }
  },
  "composition": {
    "scene_field": "components",
    "instance_fields": [
      "id",
      "component",
      "data",
      "cues",
      "start",
      "duration",
      "frame",
      "design_reference"
    ],
    "frame": "[x,y,width,height], uniform aspect-preserving fit on a 1920x1080 canvas",
    "defaults": "scene duration and full frame",
    "extension_signature": "render(kit, prefix, duration, data, cues, locale)"
  }
}
