        "total-label",
        "part-label",
        "note"
      ],
      "foreground_media_slots": [],
      "examples": "locales/<locale>/base-examples.json"
    },
    "timeline": {
      "required_text_slots": [
        "t"
      ],
      "foreground_media_slots": [
        "time-film0",
        "time-film1",
        "time-film2"
      ],
      "examples": "locales/<locale>/base-examples.json"
    },
    "map-focus": {
      "required_text_slots": [
        "t",
        "note"
      ],
      "foreground_media_slots": [],
      "examples": "locales/<locale>/base-examples.json"
    },
    "map-route": {
      "required_text_slots": [
        "t",
        "note"
      ],
      "foreground_media_slots": [],
      "examples": "locales/<locale>/base-examples.json"
    },
    "map-period": {
      "required_text_slots": [
        "t",
        "note"
      ],
      "foreground_media_slots": [],
      "examples": "locales/<locale>/base-examples.json"
    },
    "context": {
      "required_text_slots": [
